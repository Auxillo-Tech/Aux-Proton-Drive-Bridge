{
  "name": "aux-proton-drive-bridge",
  "version": "0.3.3",
  "description": "Unofficial Linux desktop bridge for Proton Drive using the official Proton Drive CLI.",
  "homepage": "https://auxillo.tech",
  "repository": {
    "type": "git",
    "url": "https://github.com/Auxillo-Tech/Aux-Proton-Drive-Bridge.git"
  },
  "bugs": {
    "url": "https://github.com/Auxillo-Tech/Aux-Proton-Drive-Bridge/issues"
  },
  "desktopName": "aux-proton-drive-bridge.desktop",
  "main": "src/main/main.js",
  "license": "MIT",
  "author": {
    "name": "Auxillo",
    "email": "support@auxillo.tech"
  },
  "private": false,
  "type": "commonjs",
  "scripts": {
    "start": "electron .",
    "postinstall": "node scripts/patch-dependency-compat.js",
    "check": "npm test && node test/static-check.js",
    "test": "node --test test/*.test.js",
    "smoke:modules": "node scripts/smoke-modules.js",
    "smoke:source": "node scripts/smoke-source.js",
    "e2e:source": "node scripts/e2e-source.js",
    "e2e:restart": "node scripts/e2e-restart.js",
    "e2e:packaged": "node scripts/e2e-packaged.js",
    "smoke:appimage": "node scripts/smoke-appimage.js",
    "test:installed": "bash scripts/test-installed-packages.sh",
    "test:aur": "bash scripts/test-aur-package.sh",
    "inspect:artifacts": "node scripts/inspect-release-artifacts.js",
    "dist:x64": "bash scripts/dist-x64.sh",
    "dist:linux": "bash scripts/dist-x64.sh",
    "release:notices": "node scripts/generate-third-party-notices.js",
    "release:manifest": "node scripts/make-release-manifest.js",
    "release:source": "node scripts/make-source-archives.js",
    "release:sbom": "node scripts/make-sbom.js",
    "release:aur:update": "node scripts/update-aur-metadata.js",
    "release:sign": "bash scripts/sign-release.sh",
    "release:sign:verify": "bash scripts/sign-release.sh --verify",
    "release:all": "npm run check && npm audit --audit-level=moderate && npm run smoke:modules && npm run smoke:source && npm run e2e:source && npm run e2e:restart && npm run release:notices && npm run dist:linux && npm run smoke:appimage && npm run e2e:packaged && npm run inspect:artifacts && npm run test:installed && npm run release:source && npm run release:sbom && npm run release:aur:update && npm run test:aur && npm run release:manifest && npm run release:sign && npm run release:sign:verify",
    "integration:file-manager": "bash scripts/install-file-manager-integration.sh"
  },
  "devDependencies": {
    "@cyclonedx/cyclonedx-npm": "^6.0.0",
    "@electron/fuses": "^2.1.3",
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.1"
  },
  "overrides": {
    "brace-expansion": "5.0.9",
    "fast-uri": "3.1.5"
  }
}
